NODE_ENV=development
PORT=3000
# Codificá los caracteres especiales de la contraseña en la URL (ej. @ -> %40).
# PostgreSQL local sin SSL: ?sslmode=disable. Neon/Supabase: ?sslmode=require.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tasks_db?sslmode=disable
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/tasks_test?sslmode=disable
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=1h
